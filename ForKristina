<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>✨ Тайный ангел для Кристины ✨</title>
  <!-- Подключаем шрифт для сказочного настроения -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Marck+Script&family=Poiret+One&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      background: radial-gradient(circle at 30% 20%, #1a0c2c, #0b0710 80%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Caveat', cursive, sans-serif;
      overflow-x: hidden;
      position: relative;
      padding: 20px;
    }

    /* Звёздный фон с анимацией мерцания */
    .stars {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    .star {
      position: absolute;
      background: white;
      border-radius: 50%;
      box-shadow: 0 0 15px 3px rgba(255, 255, 200, 0.9);
      animation: twinkle 3s infinite alternate ease-in-out;
    }

    @keyframes twinkle {
      0% { opacity: 0.3; transform: scale(0.8); }
      100% { opacity: 1; transform: scale(1.2); }
    }

    /* Главная карточка-поздравление */
    .card {
      position: relative;
      z-index: 10;
      max-width: 700px;
      width: 100%;
      background: rgba(255, 248, 240, 0.1);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 2px solid rgba(255, 215, 150, 0.5);
      border-radius: 80px 20px 80px 20px;
      padding: 50px 35px;
      box-shadow: 0 30px 50px rgba(0, 0, 0, 0.7), 0 0 80px rgba(255, 180, 80, 0.4);
      text-align: center;
      color: #fff3e0;
      animation: floatCard 5s infinite ease-in-out;
      transition: all 0.3s;
    }

    @keyframes floatCard {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-12px); }
      100% { transform: translateY(0px); }
    }

    /* Свечение по контуру */
    .card::before {
      content: "";
      position: absolute;
      inset: -5px;
      border-radius: 85px 25px 85px 25px;
      padding: 3px;
      background: linear-gradient(45deg, #ffb347, #ff6b9d, #c44dff, #ffb347);
      background-size: 300% 300%;
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      animation: borderGlow 4s linear infinite;
      z-index: -1;
    }

    @keyframes borderGlow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    h1 {
      font-family: 'Marck Script', cursive;
      font-size: 4.2rem;
      font-weight: 700;
      background: linear-gradient(to right, #fdd835, #ffb74d, #ff8a65);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 25px #ff9933);
      margin-bottom: 10px;
      letter-spacing: 2px;
      animation: titlePulse 2s infinite;
    }

    @keyframes titlePulse {
      0% { text-shadow: 0 0 25px #ff9933, 0 0 40px #ff7700; }
      50% { text-shadow: 0 0 45px #ffb703, 0 0 70px #ff5500; }
      100% { text-shadow: 0 0 25px #ff9933, 0 0 40px #ff7700; }
    }

    .angel-icon {
      font-size: 4rem;
      filter: drop-shadow(0 0 20px gold);
      margin: 10px 0;
      animation: swing 2s infinite alternate ease-in-out;
      display: inline-block;
    }

    @keyframes swing {
      0% { transform: rotate(-8deg); }
      100% { transform: rotate(8deg); }
    }

    .greeting {
      font-size: 2.2rem;
      font-weight: 500;
      color: #ffecb3;
      margin: 15px 0 10px;
      background: rgba(0,0,0,0.25);
      border-radius: 40px;
      padding: 10px 20px;
      display: inline-block;
      backdrop-filter: blur(5px);
    }

    .message {
      font-size: 1.9rem;
      line-height: 1.6;
      color: #ffe0c0;
      margin: 25px 0;
      font-weight: 500;
      text-shadow: 0 0 8px rgba(0,0,0,0.8);
      background: rgba(80, 40, 70, 0.25);
      border-radius: 50px;
      padding: 20px 18px;
      backdrop-filter: blur(4px);
      border: 1px dashed rgba(255, 200, 100, 0.6);
    }

    .santa-note {
      font-size: 2rem;
      color: #ffb997;
      font-family: 'Caveat', cursive;
      margin: 20px 0 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .gift-box {
      font-size: 3.5rem;
      animation: bounceGift 1s infinite;
      display: inline-block;
    }

    @keyframes bounceGift {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-18px); }
    }

    .footer {
      margin-top: 30px;
      font-size: 2rem;
      color: #cf9fff;
      font-weight: 700;
      letter-spacing: 1px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    /* Падающие снежинки / блёстки */
    .snowflake {
      position: fixed;
      top: -60px;
      color: #fff;
      font-size: 1.8rem;
      text-shadow: 0 0 15px cyan, 0 0 30px magenta;
      animation: fall linear infinite;
      z-index: 5;
      pointer-events: none;
    }

    @keyframes fall {
      to {
        transform: translateY(105vh) rotate(360deg);
        opacity: 0;
      }
    }

    /* адаптив */
    @media (max-width: 500px) {
      .card {
        padding: 30px 20px;
      }
      h1 {
        font-size: 3rem;
      }
      .message {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <!-- звёздный фон создаётся динамически -->
  <div class="stars" id="starsContainer"></div>

  <!-- падающие элементы (снежинки/сердечки) -->
  <div id="snowflakesContainer"></div>

  <div class="card">
    <div class="angel-icon">🪽👼✨</div>
    <h1>Кристина!</h1>
    <div class="greeting">
      🌟 Добрая Санта / Тайный ангел 🌟
    </div>
    
    <div class="message">
      Пусть этот волшебный миг<br>
      согреет сердце, как горячий какао!<br>
      Ты — светлый лучик в нашей игре,<br>
      и ангел-хранитель уже рядом.<br>
      <span style="display: inline-block; margin-top: 10px;">⭐ Сияй, мечтай и улыбайся! ⭐</span>
    </div>

    <div class="santa-note">
      <span>🎅</span> Тайный друг шепчет: <span>«Ты чудесна!»</span> <span>🤫</span>
    </div>

    <div class="gift-box">
      🎁✨🎀
    </div>

    <div class="footer">
      <span>❄️ С теплом,</span>
      <span>Твой Ангел ❄️</span>
    </div>
  </div>

  <script>
    (function() {
      // ---- создаём мерцающие звёзды ----
      const starsContainer = document.getElementById('starsContainer');
      const numberOfStars = 110;
      for (let i = 0; i < numberOfStars; i++) {
        const star = document.createElement('div');
        star.className = 'star';
        const size = Math.random() * 5 + 2; // 2px до 7px
        star.style.width = size + 'px';
        star.style.height = size + 'px';
        star.style.left = Math.random() * 100 + '%';
        star.style.top = Math.random() * 100 + '%';
        // случайная задержка анимации
        star.style.animationDelay = Math.random() * 4 + 's';
        star.style.animationDuration = 2 + Math.random() * 5 + 's';
        // немного разных оттенков
        const colors = ['#fffde7', '#fff9c4', '#ffe0b2', '#ffccbc', '#e1bee7'];
        star.style.background = colors[Math.floor(Math.random() * colors.length)];
        star.style.boxShadow = `0 0 ${Math.random() * 20 + 5}px ${colors[Math.floor(Math.random() * colors.length)]}`;
        starsContainer.appendChild(star);
      }

      // ---- падающие снежинки / блёстки ----
      const snowflakesContainer = document.getElementById('snowflakesContainer');
      const emojis = ['❄️', '✨', '🌟', '💫', '🕊️', '🎀', '🔮', '🧚', '☃️', '💖', '⭐', '🪽'];
      
      function createSnowflake() {
        const flake = document.createElement('div');
        flake.className = 'snowflake';
        const emoji = emojis[Math.floor(Math.random() * emojis.length)];
        flake.innerHTML = emoji;
        flake.style.left = Math.random() * 100 + '%';
        flake.style.fontSize = (Math.random() * 25 + 15) + 'px';
        flake.style.animationDuration = Math.random() * 6 + 6 + 's'; // от 6 до 12 секунд
        flake.style.opacity = Math.random() * 0.8 + 0.3;
        flake.style.filter = `drop-shadow(0 0 ${Math.random()*10+5}px gold)`;
        snowflakesContainer.appendChild(flake);

        // удаляем после окончания анимации, чтобы не переполнять DOM
        setTimeout(() => {
          if (flake && flake.parentNode) {
            flake.remove();
          }
        }, 13000);
      }

      // Создаём снежинки с интервалом
      setInterval(createSnowflake, 400);
      // сразу несколько для плотности
      for (let i = 0; i < 12; i++) {
        setTimeout(createSnowflake, i * 150);
      }

      // дополнительно: лёгкое движение звёзд при движении мыши (по желанию, но оставим минимально)
      document.addEventListener('mousemove', (e) => {
        const card = document.querySelector('.card');
        if (!card) return;
        const xAxis = (window.innerWidth / 2 - e.clientX) / 40;
        const yAxis = (window.innerHeight / 2 - e.clientY) / 40;
        card.style.transform = `translateY(-8px) rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
      });

      // возвращаем на место когда мышь уходит
      document.addEventListener('mouseleave', () => {
        const card = document.querySelector('.card');
        if (card) {
          card.style.transform = 'translateY(0px) rotateY(0deg) rotateX(0deg)';
        }
      });

    })();
  </script>
</body>
</html>
